# Fly Storage Layer — Environment Variables
# All backends are OPTIONAL. System works with local SQLite/DuckDB only.
# Copy to .env and fill in values for backends you want to enable.

# ── Supabase (PostgreSQL cloud backup) ──
# Free: 500MB DB + 50K requests/month
# https://supabase.com
SUPABASE_URL=
SUPABASE_KEY=

# ── Firebase (real-time state) ──
# Free: 1GB storage + 50K reads/day
# JSON string of service account credentials
FIREBASE_CREDENTIALS=

# ── ClickHouse Cloud (OLAP analytics) ──
# Free: 10GB storage + 100GB queries/month
# https://clickhouse.cloud
CLICKHOUSE_HOST=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=false

# ── Cloudflare R2 (object storage) ──
# Free: 10GB + 1M requests/month + $0 egress
# https://www.cloudflare.com/products/r2/
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=fly-data

# ── Redis / Upstash (cache) ──
# Free: 256MB + 10K commands/day
# https://upstash.com
REDIS_URL=

# ── Numerai (tournament) ──
# Free: signup at https://numer.ai
NUMERAI_PUBLIC_ID=
NUMERAI_SECRET_KEY=

# ── QuantConnect (backtesting) ──
# Free: 10 backtests/month
# https://www.quantconnect.com
QC_USER_ID=
QC_API_TOKEN=

# ── Finnhub (real-time WebSocket live data) ──
# Free: real-time US stocks + crypto
# https://finnhub.io/register
FINNHUB_TOKEN=

# ── Optional AI research judges ──
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELS=qwen2.5:7b,deepseek-r1:7b
